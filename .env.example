# Copy to ``.env`` and fill in. Never commit ``.``.
#   cp .env.example .env

# --- Required for PDF → logics extraction (default engine: Manus) ---
MANUS_API_KEY=

# --- Optional: use Claude on Vertex instead of Manus ---
# POST /runs/logics/start?engine=opus
#GOOGLE_CLOUD_PROJECT=
#GOOGLE_CLOUD_LOCATION=us-east5

# --- Optional platform tuning ---
#LOGIC_PLATFORM_RUNS_ROOT=runs
#LOGIC_PLATFORM_WEB_DIST=
#LOGIC_PLATFORM_LOG_LEVEL=INFO
